# SQLite Database (Zero-dependency local database file)
DATABASE_URL="file:./dev.db"

# Backend configuration
PORT=4000
NODE_ENV=development

# LLM Providers (Specify 'gemini', 'openai', 'groq', or 'demo')
LLM_PROVIDER=demo

# API Keys (Provide at least one for live LLM execution)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Demo Mode (Forces deterministic fallback if true or if API key is missing)
DEMO_MODE=true

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
