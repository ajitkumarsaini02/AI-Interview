# ===================================================
# 🚀 INTERVIEW AI — ENVIRONMENT VARIABLES CONFIGURATION
# ===================================================

# 1. OpenAI API Key (Required for AI Question Generation & Evaluation)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# 2. MongoDB Atlas Connection URI (Required for Vercel Persistent Storage)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/interview_agent?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/interview_agent?retryWrites=true&w=majority

# 3. MongoDB Database Name (Optional, defaults to interview_agent)
MONGODB_DB=interview_agent
