{
  "name": "ai-interview-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "node scripts/start-backend.js",
    "dev:node": "USE_NODE=true node scripts/start-backend.js",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "echo 'Backend ready'",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:frontend",
    "test": "node scripts/test-backend.js",
    "test:node": "npm test --workspace=backend",
    "db:generate": "echo 'Auto-initialized'",
    "db:push": "echo 'Auto-initialized'",
    "db:seed": "echo 'Seeded via retrieval service'"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
